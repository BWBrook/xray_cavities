#!/usr/bin/env bash
#PBS -N c_hi_pend_sum
#PBS -q normal
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
#PBS -o /u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_endpoint_summary.out
#PBS -e /u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_endpoint_summary.err

set -euo pipefail

RUN_OUT="${RUN_OUT:-/scratch/bwbrook/xray_cavities_runs/2026-06-06-c-hi-fullgrid-agn-impi-r9-prod64/C-HI/particles/problem/outputs}"
PARTICLE_FILE="${PARTICLE_FILE:-$RUN_OUT/particles.5000.dbl}"
SUMMARY_SCRIPT="${SUMMARY_SCRIPT:-/u/bwbrook/codex_kunanyi/pes.py}"
OUTPUT_DIR="${OUTPUT_DIR:-/scratch/bwbrook/xray_cavities_analysis/2026-06-08-c-hi-fullgrid-final-particle-endpoint-summary}"
SUMMARY_ARCHIVE="${SUMMARY_ARCHIVE:-/u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_endpoint_summary_2026-06-08.tar.gz}"

module purge
module load Anaconda3/2024.02-1

mkdir -p "$OUTPUT_DIR"
cd "$PBS_O_WORKDIR"

echo "jobid=$PBS_JOBID"
echo "host=$(hostname)"
echo "particle_file=$PARTICLE_FILE"
echo "summary_script=$SUMMARY_SCRIPT"
echo "output_dir=$OUTPUT_DIR"
echo "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
python "$SUMMARY_SCRIPT" \
  --particle-file "$PARTICLE_FILE" \
  --output-dir "$OUTPUT_DIR" \
  --run-label "C-HI full-grid 50 Myr endpoint" \
  --max-position-rows 20000

find "$OUTPUT_DIR" -maxdepth 1 -type f -printf "%f\t%s bytes\n" | sort
rm -f "$SUMMARY_ARCHIVE"
tar -czf "$SUMMARY_ARCHIVE" -C "$(dirname "$OUTPUT_DIR")" "$(basename "$OUTPUT_DIR")"
sha256sum "$SUMMARY_ARCHIVE"
echo "finished_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
