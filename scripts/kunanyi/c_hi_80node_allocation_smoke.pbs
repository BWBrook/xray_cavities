#!/bin/bash
#PBS -N c_hi_80alloc
#PBS -q normal
#PBS -l select=80:ncpus=28:mpiprocs=28
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -M barry.brook@utas.edu.au
#PBS -m abe
#PBS -o /u/bwbrook/codex_kunanyi/c_hi_80node_allocation_smoke.out

set -euo pipefail

EXPECTED_NNODES="${EXPECTED_NNODES:-80}"
EXPECTED_RANKS="${EXPECTED_RANKS:-2240}"
WORK_ROOT="${WORK_ROOT:-/scratch/bwbrook/xray_cavities_alloc_smokes}"
WORKDIR="${WORK_ROOT}/${PBS_JOBID:-manual}"
SUMMARY_ARCHIVE="${SUMMARY_ARCHIVE:-/u/bwbrook/codex_kunanyi/c_hi_80node_allocation_smoke_${PBS_JOBID:-manual}.tar.gz}"

mkdir -p "$WORKDIR"
cd "$WORKDIR"

echo "JOB_START=$(date -Is)"
echo "HOST=$(hostname)"
echo "USER=$(whoami)"
echo "PWD=$PWD"
echo "PBS_JOBID=${PBS_JOBID:-unset}"
echo "PBS_QUEUE=${PBS_QUEUE:-unset}"
echo "PBS_NODEFILE=${PBS_NODEFILE:-unset}"
echo "EXPECTED_NNODES=$EXPECTED_NNODES"
echo "EXPECTED_RANKS=$EXPECTED_RANKS"

if [ -z "${PBS_NODEFILE:-}" ] || [ ! -f "$PBS_NODEFILE" ]; then
  echo "ERROR: PBS_NODEFILE is missing" >&2
  exit 1
fi

cp "$PBS_NODEFILE" pbs_nodefile.txt
NRANKS="$(wc -l < "$PBS_NODEFILE")"
NNODES="$(sort -u "$PBS_NODEFILE" | wc -l)"
UNIQUE_NODES="$(sort -u "$PBS_NODEFILE" | paste -sd, -)"

echo "NRANKS=$NRANKS"
echo "NNODES=$NNODES"
echo "UNIQUE_NODES=$UNIQUE_NODES"
sort "$PBS_NODEFILE" | uniq -c | awk '{print $2 " slots=" $1}' > ompi_hostfile
echo "OMPI_HOSTFILE_HEAD:"
sed -n '1,20p' ompi_hostfile
echo "OMPI_HOSTFILE_TAIL:"
tail -n 20 ompi_hostfile

if [ "$NRANKS" -ne "$EXPECTED_RANKS" ]; then
  echo "ERROR: expected $EXPECTED_RANKS PBS slots, got $NRANKS" >&2
  exit 1
fi

if [ "$NNODES" -ne "$EXPECTED_NNODES" ]; then
  echo "ERROR: expected $EXPECTED_NNODES unique nodes, got $NNODES" >&2
  exit 1
fi

module purge
module load HDF5/1.14.0-gompi-2023a

echo "MODULES=${LOADEDMODULES:-}"
echo "TOOL_PATHS:"
command -v gcc
command -v h5pcc
command -v h5dump
command -v mpirun
mpirun --version | head -2
h5pcc -show

cat > mpi_hdf5_alloc_smoke.c <<'C'
#include <mpi.h>
#include <hdf5.h>
#include <stdio.h>

int main(int argc, char **argv) {
  MPI_Init(&argc, &argv);

  int rank = 0;
  int size = 0;
  char processor[MPI_MAX_PROCESSOR_NAME];
  int processor_len = 0;

  MPI_Comm_rank(MPI_COMM_WORLD, &rank);
  MPI_Comm_size(MPI_COMM_WORLD, &size);
  MPI_Get_processor_name(processor, &processor_len);

  int one = 1;
  int count = 0;
  long long local_rank = rank;
  long long rank_sum = 0;
  MPI_Reduce(&one, &count, 1, MPI_INT, MPI_SUM, 0, MPI_COMM_WORLD);
  MPI_Reduce(&local_rank, &rank_sum, 1, MPI_LONG_LONG, MPI_SUM, 0, MPI_COMM_WORLD);

  hid_t fapl = H5Pcreate(H5P_FILE_ACCESS);
  if (H5Pset_fapl_mpio(fapl, MPI_COMM_WORLD, MPI_INFO_NULL) < 0) return 10;
  hid_t file = H5Fcreate("mpi_hdf5_alloc_smoke.h5", H5F_ACC_TRUNC, H5P_DEFAULT, fapl);
  if (file < 0) return 11;

  hsize_t file_dims[1] = {(hsize_t)size};
  hsize_t mem_dims[1] = {1};
  hid_t file_space = H5Screate_simple(1, file_dims, NULL);
  hid_t mem_space = H5Screate_simple(1, mem_dims, NULL);
  hid_t dset = H5Dcreate2(file, "rank_values", H5T_NATIVE_INT, file_space,
                         H5P_DEFAULT, H5P_DEFAULT, H5P_DEFAULT);
  hsize_t start[1] = {(hsize_t)rank};
  hsize_t count_h5[1] = {1};
  H5Sselect_hyperslab(file_space, H5S_SELECT_SET, start, NULL, count_h5, NULL);
  hid_t dxpl = H5Pcreate(H5P_DATASET_XFER);
  H5Pset_dxpl_mpio(dxpl, H5FD_MPIO_COLLECTIVE);
  int value = rank;
  if (H5Dwrite(dset, H5T_NATIVE_INT, mem_space, file_space, dxpl, &value) < 0) return 12;

  H5Pclose(dxpl);
  H5Dclose(dset);
  H5Sclose(mem_space);
  H5Sclose(file_space);
  H5Fclose(file);
  H5Pclose(fapl);

  if (rank == 0) {
    long long expected_sum = ((long long)size * (long long)(size - 1)) / 2LL;
    printf("MPI_SIZE=%d\n", size);
    printf("MPI_REDUCED_COUNT=%d\n", count);
    printf("MPI_RANK_SUM=%lld\n", rank_sum);
    printf("MPI_EXPECTED_RANK_SUM=%lld\n", expected_sum);
  }

  if (rank < 8 || rank >= size - 8 || rank % 28 == 0) {
    printf("RANK_SAMPLE rank=%04d size=%04d host=%s\n", rank, size, processor);
  }
  fflush(stdout);

  MPI_Finalize();
  return 0;
}
C

h5pcc mpi_hdf5_alloc_smoke.c -O2 -o mpi_hdf5_alloc_smoke

echo "MPI_RUN_START=$(date -Is)"
mpirun -x LD_LIBRARY_PATH -x PATH --hostfile ompi_hostfile -np "$NRANKS" ./mpi_hdf5_alloc_smoke \
  | sort | tee mpi_hdf5_alloc_smoke.out
echo "MPI_RUN_END=$(date -Is)"

echo "H5DUMP_HEADER:"
h5dump -H mpi_hdf5_alloc_smoke.h5
HDF5_BYTES="$(wc -c < mpi_hdf5_alloc_smoke.h5)"
MPI_SIZE_LINES="$(grep -c '^MPI_SIZE=' mpi_hdf5_alloc_smoke.out || true)"
MPI_REDUCED_COUNT="$(awk -F= '$1=="MPI_REDUCED_COUNT" {print $2}' mpi_hdf5_alloc_smoke.out)"
MPI_RANK_SUM="$(awk -F= '$1=="MPI_RANK_SUM" {print $2}' mpi_hdf5_alloc_smoke.out)"
MPI_EXPECTED_RANK_SUM="$(awk -F= '$1=="MPI_EXPECTED_RANK_SUM" {print $2}' mpi_hdf5_alloc_smoke.out)"
SAMPLE_LINES="$(grep -c '^RANK_SAMPLE ' mpi_hdf5_alloc_smoke.out || true)"

{
  echo "pbs_jobid=${PBS_JOBID:-manual}"
  echo "workdir=$WORKDIR"
  echo "nranks=$NRANKS"
  echo "nnodes=$NNODES"
  echo "hdf5_bytes=$HDF5_BYTES"
  echo "mpi_size_lines=$MPI_SIZE_LINES"
  echo "mpi_reduced_count=$MPI_REDUCED_COUNT"
  echo "mpi_rank_sum=$MPI_RANK_SUM"
  echo "mpi_expected_rank_sum=$MPI_EXPECTED_RANK_SUM"
  echo "rank_sample_lines=$SAMPLE_LINES"
  echo "started=$(date -Is)"
} > allocation_summary.txt

cat allocation_summary.txt

if [ "$MPI_SIZE_LINES" -ne 1 ]; then
  echo "ERROR: expected one MPI_SIZE line, got $MPI_SIZE_LINES" >&2
  exit 1
fi
if [ "$MPI_REDUCED_COUNT" -ne "$NRANKS" ]; then
  echo "ERROR: MPI reduced count $MPI_REDUCED_COUNT != NRANKS $NRANKS" >&2
  exit 1
fi
if [ "$MPI_RANK_SUM" -ne "$MPI_EXPECTED_RANK_SUM" ]; then
  echo "ERROR: rank sum $MPI_RANK_SUM != expected $MPI_EXPECTED_RANK_SUM" >&2
  exit 1
fi
if [ "$HDF5_BYTES" -le 0 ]; then
  echo "ERROR: expected a non-empty HDF5 file" >&2
  exit 1
fi

tar -czf "$SUMMARY_ARCHIVE" allocation_summary.txt pbs_nodefile.txt ompi_hostfile mpi_hdf5_alloc_smoke.out
sha256sum "$SUMMARY_ARCHIVE"
echo "SUMMARY_ARCHIVE=$SUMMARY_ARCHIVE"
echo "JOB_END=$(date -Is)"
echo "OK"
