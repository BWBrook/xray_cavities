#!/usr/bin/env bash
#PBS -N c_hi_ph5_pf
#PBS -q normal
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
#PBS -o /u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_hdf5_preflight.out
#PBS -e /u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_hdf5_preflight.err

set -euo pipefail

RUN_OUT="${RUN_OUT:-/scratch/bwbrook/xray_cavities_runs/2026-06-06-c-hi-fullgrid-agn-impi-r9-prod64/C-HI/particles/problem/outputs}"
RUNTIME_DIR="${RUNTIME_DIR:-/u/bwbrook/codex_kunanyi/particle_loss_runtime}"
SCRIPT="${SCRIPT:-$RUNTIME_DIR/estimate_particle_hdf5_feasibility.py}"
PLUTOKORE_SRC="${PLUTOKORE_SRC:-$RUNTIME_DIR/plutokore/src}"
COMPAT_DIR="${COMPAT_DIR:-$RUNTIME_DIR/python_compat}"
OUTPUT_DIR="${OUTPUT_DIR:-/scratch/bwbrook/xray_cavities_analysis/2026-06-07-c-hi-fullgrid-final-particle-hdf5-preflight}"
SUMMARY_ARCHIVE="${SUMMARY_ARCHIVE:-/u/bwbrook/codex_kunanyi/c_hi_fullgrid_final_particle_hdf5_preflight_2026-06-07.tar.gz}"

module purge
module load Anaconda3/2024.02-1

export PYTHONPATH="$COMPAT_DIR:$PLUTOKORE_SRC${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1
export NUMBA_NUM_THREADS=1

mkdir -p "$OUTPUT_DIR"
cd "$PBS_O_WORKDIR"

echo "jobid=$PBS_JOBID"
echo "host=$(hostname)"
echo "python=$(command -v python)"
python --version
echo "run_out=$RUN_OUT"
echo "runtime_dir=$RUNTIME_DIR"
echo "script=$SCRIPT"
echo "plutokore_src=$PLUTOKORE_SRC"
echo "compat_dir=$COMPAT_DIR"
echo "output_dir=$OUTPUT_DIR"
echo "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

python "$SCRIPT" \
  --sim-dir "$RUN_OUT" \
  --output-dir "$OUTPUT_DIR" \
  --peak-multiplier 10.0 \
  --max-memory-gib 128.0

find "$OUTPUT_DIR" -maxdepth 1 -type f -printf "%f\t%s bytes\n" | sort
rm -f "$SUMMARY_ARCHIVE"
tar -czf "$SUMMARY_ARCHIVE" -C "$(dirname "$OUTPUT_DIR")" "$(basename "$OUTPUT_DIR")"
sha256sum "$SUMMARY_ARCHIVE"
echo "finished_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
