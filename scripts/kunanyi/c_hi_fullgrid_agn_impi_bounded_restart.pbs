#!/bin/bash
#PBS -N c_hi_fg_agn8
#PBS -q normal
#PBS -l select=8:ncpus=28:mpiprocs=28
#PBS -l walltime=02:00:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
#PBS -o /u/bwbrook/codex_kunanyi/c_hi_fullgrid_agn_impi_bounded_restart.out
#PBS -e /u/bwbrook/codex_kunanyi/c_hi_fullgrid_agn_impi_bounded_restart.err

set -euo pipefail

# Bounded production-style restart test for the full-grid C-HI particles run
# under Patrick's AGN Intel/IMPI/HDF5/ZFP stack. This deliberately restarts
# from the existing initial checkpoint and rebuilds PLUTO under Intel/IMPI, but
# uses only 8 nodes and a short PLUTO wall-clock limit before any 80-node retry.
export CASE_ID="${CASE_ID:-C-HI}"
export CASE_VARIANT="${CASE_VARIANT:-particles}"
export CASE_CONFIG_DIR="${CASE_CONFIG_DIR:-/u/bwbrook/codex_kunanyi/c_hi_fullgrid_startup_2026-05-19/C-HI/particles}"
export RUN_ROOT="${RUN_ROOT:-/scratch/bwbrook/xray_cavities_runs/2026-05-19-c-hi-fullgrid-startup}"
export PLUTO_MAXTIME_HOURS="${PLUTO_MAXTIME_HOURS:-0.5}"
export RESTART_POLICY="${RESTART_POLICY:-auto}"
export ALLOW_DONE_RERUN="${ALLOW_DONE_RERUN:-1}"
export BUILD_JOBS="${BUILD_JOBS:-28}"
export FORCE_REBUILD="${FORCE_REBUILD:-1}"
export KUNANYI_MODULE_STACK="${KUNANYI_MODULE_STACK:-agn_intel_impi}"
export MPI_FLAVOR="${MPI_FLAVOR:-intelmpi}"

BASE_SCRIPT="${BASE_SCRIPT:-/u/bwbrook/codex_kunanyi/jet_setup_production_template_latest.pbs}"
exec bash "$BASE_SCRIPT"
