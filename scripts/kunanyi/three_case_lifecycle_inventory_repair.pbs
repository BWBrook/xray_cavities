#!/usr/bin/env bash
#PBS -N tri_liferep
#PBS -q normal
#PBS -l select=1:ncpus=8:mpiprocs=1:mem=64gb
#PBS -l walltime=48:00:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
#PBS -o /u/bwbrook/codex_kunanyi/goal046_three_case_lifecycle_inventory_repair/three_case_lifecycle_inventory_repair.out
#PBS -e /u/bwbrook/codex_kunanyi/goal046_three_case_lifecycle_inventory_repair/three_case_lifecycle_inventory_repair.err

set -euo pipefail

export STAGE_DIR="${STAGE_DIR:-/u/bwbrook/codex_kunanyi/goal046_three_case_lifecycle_inventory_repair}"
export ANALYSIS_ROOT="${ANALYSIS_ROOT:-/scratch/bwbrook/xray_cavities_analysis/2026-07-24-three-case-lifecycle-inventory-repair}"
export ARCHIVE="${ARCHIVE:-$STAGE_DIR/three_case_lifecycle_inventory_repair_2026-07-24.tar.gz}"
BASE_WRAPPER="${BASE_WRAPPER:-$STAGE_DIR/three_case_lifecycle_inventory.pbs}"

test -r "$BASE_WRAPPER" || {
  echo "missing base inventory wrapper: $BASE_WRAPPER" >&2
  exit 2
}

exec bash "$BASE_WRAPPER"
