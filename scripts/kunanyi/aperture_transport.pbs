#!/bin/bash
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=6gb
#PBS -l walltime=08:00:00
#PBS -m ae
#PBS -j oe
#PBS -r n
set -euo pipefail
umask 077
cd "${PBS_O_WORKDIR:?submit from the staged analysis directory}"
printf '%s  stage.sha256\n' "${TRANSPORT_STAGE_SHA:?}" | sha256sum --check --quiet -
sha256sum --check --quiet stage.sha256
export PYTHONPATH="$PWD/science" PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
read -ra indices <<< "${TRANSPORT_INDICES//:/ }"
/share/apps/software/Anaconda3/2024.02-1/bin/python -u "$PWD/run_aperture_transport.py" "$PWD" "${TRANSPORT_CASE:?}" "${indices[@]}"
