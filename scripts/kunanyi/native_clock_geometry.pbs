#!/bin/bash
#PBS -N native_clocks
#PBS -q normal
#PBS -J 0-18
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -m ae
#PBS -j oe
#PBS -r y
set -euo pipefail
umask 077
cd "${PBS_O_WORKDIR:?}"
printf '%s  stage.sha256\n' "${CLOCK_STAGE_SHA:?}" | sha256sum --check --quiet -
sha256sum --check --quiet stage.sha256
ref="${CLOCK_REFERENCE_STAGE:?}"
(cd "$ref" && printf '%s  stage.sha256\n' '6d891b93b5905a686d7f6c457cba881bab4e1df6a892cdcc7da39d56cdca3215' | sha256sum --check --quiet - && sha256sum --check --quiet stage.sha256)
export PYTHONPATH="$ref/science" PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cases=(C-HI C-LO G-LO G-HI)
indices=(10 20 30 40 50)
slot=${PBS_ARRAY_INDEX:?}
case_id=${cases[slot/5]}
index=${indices[slot%5]}
printf -v receipt 'results/%s_%04d.json' "$case_id" "$index"
/share/apps/software/Anaconda3/2024.02-1/bin/python -u measure_native_clock_geometry.py \
    --stage "$ref" --case "$case_id" --index "$index" --output "$receipt"
