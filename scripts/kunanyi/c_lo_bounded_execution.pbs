#!/bin/bash
#PBS -N c_lo_bound
#PBS -q normal
#PBS -l select=80:ncpus=28:mpiprocs=28
#PBS -l walltime=04:00:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
#PBS -o /u/bwbrook/codex_kunanyi/goal032_c_lo_bounded_execution/c_lo_bounded_execution.out
#PBS -e /u/bwbrook/codex_kunanyi/goal032_c_lo_bounded_execution/c_lo_bounded_execution.err

set -euo pipefail

# Bounded C-LO startup/checkpoint execution using the Goal 031 restored
# Stewart 002_003 tabulated asset and the existing C-HI production template.
# This is not a completion/retrieval/product wrapper; the submitting agent must
# stop after the scheduler returns a queued or running PBS job.
export CASE_ID="${CASE_ID:-C-LO}"
export CASE_VARIANT="${CASE_VARIANT:-particles}"
export CASE_CONFIG_DIR="${CASE_CONFIG_DIR:-/u/bwbrook/codex_kunanyi/goal032_c_lo_bounded_execution/rendered_c_lo_config/C-LO/particles}"
export RUN_ROOT="${RUN_ROOT:-/scratch/bwbrook/xray_cavities_runs/2026-07-03-c-lo-bounded-execution}"
export PLUTO_MAXTIME_HOURS="${PLUTO_MAXTIME_HOURS:-3.5}"
export RESTART_POLICY="${RESTART_POLICY:-force-fresh}"
export ALLOW_DONE_RERUN="${ALLOW_DONE_RERUN:-0}"
export BUILD_JOBS="${BUILD_JOBS:-28}"
export FORCE_REBUILD="${FORCE_REBUILD:-0}"
export KUNANYI_MODULE_STACK="${KUNANYI_MODULE_STACK:-agn_intel_impi}"
export MPI_FLAVOR="${MPI_FLAVOR:-intelmpi}"
export HDF5_USE_FILE_LOCKING="${HDF5_USE_FILE_LOCKING:-FALSE}"

BASE_SCRIPT="${BASE_SCRIPT:-/u/bwbrook/codex_kunanyi/goal032_c_lo_bounded_execution/jet_setup_production_template_latest.pbs}"
exec bash "$BASE_SCRIPT"
