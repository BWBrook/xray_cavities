#PBS -N jet_setup_3d_smoke
#PBS -q test
#PBS -l select=1:ncpus=8:mpiprocs=8
#PBS -l walltime=00:20:00
#PBS -o /u/bwbrook/codex_kunanyi/jet_setup_tiny_3d_cart.out
#PBS -e /u/bwbrook/codex_kunanyi/jet_setup_tiny_3d_cart.err

set -euo pipefail

export LC_ALL=C
export LANG=C

PLUTO_DIR=/scratch/bwbrook/git/utas-agn/pluto
JET_SETUP=/scratch/bwbrook/git/utas-agn/jet-setup
WORKDIR=/scratch/bwbrook/jet_setup_smoke/tiny_3d_cart
PROBLEM="$WORKDIR/problem"
RESULTS="$WORKDIR/results"
NRANKS=8

module purge
module load HDF5/1.14.0-gompi-2023a
export HDF5_DIR="${HDF5_DIR:-${EBROOTHDF5:-/share/apps/software/HDF5/1.14.0-gompi-2023a}}"
export PLUTO_DIR

echo "JOB_START=$(date)"
echo "HOST=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-}"
echo "PBS_NODEFILE=${PBS_NODEFILE:-}"
if [ -n "${PBS_NODEFILE:-}" ] && [ -f "$PBS_NODEFILE" ]; then
  echo "NODEFILE_CONTENTS=$(tr '\n' ' ' < "$PBS_NODEFILE")"
fi
echo "MODULES=${LOADEDMODULES:-}"
echo "HDF5_DIR=${HDF5_DIR}"
echo "mpicc=$(command -v mpicc)"
echo "mpirun=$(command -v mpirun)"
echo "python3=$(command -v python3)"

rm -rf "$WORKDIR"
mkdir -p "$PROBLEM" "$RESULTS"

patch_define() {
  local path="$1"
  local key="$2"
  local value="$3"
  python3 - "$path" "$key" "$value" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]
lines = path.read_text().splitlines()
out = []
replaced = False
for line in lines:
    parts = line.split()
    if len(parts) >= 2 and parts[0] == "#define" and parts[1] == key:
        out.append(f"#define  {key.ljust(28)}   {value}")
        replaced = True
    else:
        out.append(line)
if not replaced:
    raise SystemExit(f"missing define {key} in {path}")
path.write_text("\n".join(out) + "\n")
PY
}

(
  cd "$PROBLEM"
  "$JET_SETUP/tools/setup-problem"
)

patch_define "$PROBLEM/src/definitions.h" PHYSICS HD
patch_define "$PROBLEM/src/definitions.h" DIMENSIONS 3
patch_define "$PROBLEM/src/definitions.h" GEOMETRY CARTESIAN
patch_define "$PROBLEM/src/definitions.h" BODY_FORCE VECTOR
patch_define "$PROBLEM/src/definitions.h" PARTICLES NO
patch_define "$PROBLEM/src/definitions.h" EOS IDEAL
patch_define "$PROBLEM/src/definitions_usr.h" DENSITY_PROFILE ENV_KING
patch_define "$PROBLEM/src/definitions_usr.h" JET_INJECTION_ROTATED NO
patch_define "$PROBLEM/src/definitions_usr.h" JET_RELATIVISTIC_DENSITY NO
patch_define "$PROBLEM/src/definitions_usr.h" PARTICLES_LP_RAISE NO

cat > "$PROBLEM/src/local_make" <<'MAKE'
OBJ += coordinates.o jet.o units.o environment_utilities.o environment.o tools_usr.o read_external_pressure.o galaxy.o
HEADERS += definitions_usr.h pluto_usr.h structs_usr.h coordinates.h jet.h units.h environment_utilities.h environment.h tools_usr.h read_external_pressure.h galaxy.h
MAKE

cat > "$PROBLEM/pluto.ini" <<'INI'
[Grid]

X1-grid  1  -12.0   48  u   12.0
X2-grid  1  -12.0   48  u   12.0
X3-grid  1  -18.0   72  u   18.0

[Chombo Refinement]

Levels           4
Ref_ratio        2 2 2 2 2
Regrid_interval  2 2 2 2
Refine_thresh    0.3
Tag_buffer_size  3
Block_factor     8
Max_grid_size    64
Fill_ratio       0.75

[Time]

CFL              0.33
CFL_max_var      1.1
tstop            300.0
first_dt         1.0e-3

[Solver]

Solver           hllc

[Boundary]

X1-beg           outflow
X1-end           outflow
X2-beg           outflow
X2-end           outflow
X3-beg           outflow
X3-end           outflow

[Static Grid Output]

log_dir          ./outputs/logs
output_dir       ./outputs
uservar          0
dbl              150.0  -1   single_file
flt              -1.0  -1   single_file
dbl.h5           -1.0  -1
flt.h5           -1.0  -1
vtk              -1.0  -1   single_file
tab              -1.0  -1
ppm              -1.0  -1
png              -1.0  -1
log              20
analysis         -1.0  -1

[Chombo HDF5 output]

Checkpoint_interval  -1.0  0
Plot_interval        -1.0  0

[Particles]

Nparticles          -1    -1
particles_dbl       -1.0  -1
particles_flt       -1.0  -1
particles_vtk       -1.0  -1
particles_tab       -1.0  -1

[Parameters]

JET_PWR                     1e45
JET_SPD                     0.9
JET_CHI                     100.0
JET_OA_PRIMARY              15.0
JET_OA_SECONDARY            15.0
JET_INJECTION_HEIGHT        1.0
JET_INITIAL_RADIUS          1.0
JET_X1O                     0.0
JET_X2O                     0.0
JET_X3O                     0.0
JET_ROTATION_ANGLE          0.0
JET_START_TIME              0.0
JET_END_TIME                300.0
JET_ACTIVE_TIME             300.0
JET_EPISODES                1.0
ENV_RHO_0                   2.4e-27
ENV_R_SCALING               144.0
ENV_DELTA_NFW               0.0
ENV_B_EXPONENT              0.38
ENV_TEMP                    3.462e7
ENV_X1O                     0.0
ENV_X2O                     0.0
ENV_X3O                     0.0
PART_INJECT_FREQUENCY       1.0
STELLAR_MASS                0.0
INI

cp "$PROBLEM/pluto.ini" "$PROBLEM/src/pluto.ini"
cat > "$PROBLEM/src/makefile" <<'MAKE'
ARCH         = Kunanyi.defs
MAKE

# PLUTO 4.4's --no-curses path still calls raw_input in some setup routes.
python3 - <<'PY'
from pathlib import Path
path = Path("/scratch/bwbrook/git/utas-agn/pluto/Tools/Python/menu.py")
text = path.read_text()
needle = "raw_input = input"
if needle not in text:
    text = text.replace(
        "import os, sys, traceback, time, string",
        "import os, sys, traceback, time, string\nraw_input = input",
        1,
    )
    path.write_text(text)
PY

echo "--- generate makefile ---"
(
  cd "$PROBLEM/src"
  python3 - <<PY
import sys
sys.path.append("$PLUTO_DIR/Tools/Python")
from make_problem import MakeProblem
MakeProblem("$PROBLEM/src", "$PLUTO_DIR", 1, 1)
PY
)

echo "--- makefile arch ---"
grep -E '^(ARCH|PLUTO_DIR|VPATH)' "$PROBLEM/src/makefile"

echo "--- build ---"
make -C "$PROBLEM/src" clean
make -C "$PROBLEM/src" -j"$NRANKS"
cp "$PROBLEM/src/pluto" "$PROBLEM/pluto"

echo "--- run ---"
(
  cd "$PROBLEM"
  rm -rf outputs
  mkdir -p outputs/logs
  mpirun -np "$NRANKS" ./pluto -i pluto.ini > outputs/logs/pluto.log 2>&1
)

if [ ! -f "$PROBLEM/outputs/data.0002.dbl" ]; then
  echo "[error] expected final dbl output missing" >&2
  find "$PROBLEM/outputs" -maxdepth 2 -type f -print >&2 || true
  exit 1
fi

cp "$PROBLEM/pluto.ini" "$RESULTS/pluto.ini"
cp "$PROBLEM/src/definitions.h" "$RESULTS/definitions.h"
cp "$PROBLEM/src/definitions_usr.h" "$RESULTS/definitions_usr.h"
mkdir -p "$RESULTS/logs"
cp "$PROBLEM/outputs/logs/pluto.log" "$RESULTS/pluto.log"
cp "$PROBLEM/outputs/logs"/pluto.*.log "$RESULTS/logs/"
cp "$PROBLEM/outputs/dbl.out" "$RESULTS/dbl.out"
cp "$PROBLEM/outputs/grid.out" "$RESULTS/grid.out"
cp "$PROBLEM/outputs"/data.*.dbl "$RESULTS/"

echo "--- outputs ---"
find "$PROBLEM/outputs" -maxdepth 2 -type f -print | sort

echo "--- dbl.out ---"
sed -n '1,80p' "$PROBLEM/outputs/dbl.out"

echo "--- pluto log tail ---"
tail -120 "$PROBLEM/outputs/logs/pluto.log"

echo "JOB_END=$(date)"
